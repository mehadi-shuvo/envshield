{
  "name": "@infocyph/envshield",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.0.2",
  "description": "🛡️ Validate and sync .env files against .env.example with ease.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "envshield": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format esm,cjs --dts --clean --minify",
    "dev": "ts-node src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "env",
    "dotenv",
    "environment-variables",
    "validation",
    "sync",
    "cli",
    "nextjs",
    "react"
  ],
  "author": "Mehadi Hasan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mehadi-shuvo/envshield"
  },
  "bugs": {
    "url": "https://github.com/mehadi-shuvo/envshield/issues"
  },
  "homepage": "https://github.com/mehadi-shuvo/envshield#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
